  "collections": {
    "regions": {
      "tsurumi": {
        "id": "tsurumi",
        "nameZh": "鹤见町",
        "nameJa": "鶴見町",
        "descriptionZh": "汐见川沿岸的旧生活街区。木造与砖造建筑经过多次现代化改修，旧街屋、居民巷道、河岸设施和后加管线共同构成这一地区的日常景观。",
        "descriptionJa": "汐見川沿いの古い生活街区。木造・煉瓦造の建物に改修が重ねられ、古い町家、生活路地、河岸設備、後付け配管が日常の景観を形づくる。",
        "cover": {
          "asset": "cg.region.tsurumi.01"
        },
        "gallery": [
          {
            "id": "01",
            "asset": "cg.region.tsurumi.01",
            "labelZh": "区域总览",
            "labelJa": "地区全景"
          },
          {
            "id": "02",
            "asset": "cg.region.tsurumi.02",
            "labelZh": "生活街",
            "labelJa": "生活通り"
          },
          {
            "id": "03",
            "asset": "cg.region.tsurumi.03",
            "labelZh": "河岸后巷",
            "labelJa": "河岸裏路地"
          }
        ]
      }
    },
    "places": {
      "cafe_shiosai": {
        "id": "cafe_shiosai",
        "nameZh": "喫茶「潮声」",
        "nameJa": "喫茶「潮声」",
        "descriptionZh": "鹤见町临近汐见川的老式咖啡馆。店面面向河岸生活街，内部由主要客席、吧台与临河座席组成。",
        "descriptionJa": "鶴見町の汐見川近くにある昔ながらの喫茶店。河岸の生活通りに面し、店内は主客席、カウンター、川沿いの席で構成される。",
        "cover": {
          "asset": "cg.place.cafe_shiosai.01"
        },
        "gallery": [
          {
            "id": "01",
            "asset": "cg.place.cafe_shiosai.01",
            "labelZh": "外观·河岸店面",
            "labelJa": "外観・河岸側店舗"
          },
          {
