      "matsunaga_camera": {
        "id": "matsunaga_camera",
        "nameZh": "松永写真器械店",
        "nameJa": "松永写真器械店",
        "descriptionZh": "鹤见町经营多年的写真器材与精密器械店，前场销售相机与光学器材，后场承担维修与精密调整。",
        "descriptionJa": "鶴見町で長く営業する写真機材・精密機器店。売場ではカメラや光学機器を扱い、奥では修理と精密調整を行う。",
