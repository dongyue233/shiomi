        ]
      },
      "kawakaze_so": {
        "id": "kawakaze_so",
        "nameZh": "川风庄",
        "nameJa": "川風荘",
        "descriptionZh": "位于鹤见町靠近汐见川的内巷，是带有公共玄关、楼梯和生活共用空间的旧式集合住宅。",
        "descriptionJa": "鶴見町の汐見川近くの路地にある古い集合住宅。共同玄関、階段、生活共用部を備える。",
        "cover": {
